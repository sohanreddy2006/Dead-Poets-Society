generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  playerId      Int?      @unique
  player        Player?   @relation(fields: [playerId], references: [id])
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Player {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  displayName    String
  role           String         @default("Batter")
  isRosterPlayer Boolean        @default(true)
  user           User?
  battingEntries BattingEntry[]
  bowlingEntries BowlingEntry[]
}

model Match {
  id          Int      @id @default(autoincrement())
  matchNumber Int?
  date        String
  venue       String   @default("")
  opponent    String
  tournament  String
  result      String
  potm        String
  deletedAt   DateTime?
  innings     Inning[]
}

model Inning {
  id          Int            @id @default(autoincrement())
  matchId     Int
  battingTeam String
  bowlingTeam String
  total       String         @default("")
  overs       String         @default("")
  extras      Int            @default(0)
  match       Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  batsmen     BattingEntry[]
  bowlers     BowlingEntry[]
}

model BattingEntry {
  id                Int     @id @default(autoincrement())
  inningId          Int
  playerId          Int?
  name              String
  runs              Int
  balls             Int
  fours             Int     @default(0)
  sixes             Int     @default(0)
  dismissal         String
  sr                String  @default("")
  excludedFromStats Boolean @default(false)
  inning            Inning  @relation(fields: [inningId], references: [id], onDelete: Cascade)
  player            Player? @relation(fields: [playerId], references: [id])
}

model BowlingEntry {
  id                Int     @id @default(autoincrement())
  inningId          Int
  playerId          Int?
  name              String
  overs             Float   @default(0)
  maidens           Int     @default(0)
  runs              Int
  wkts              Int     @default(0)
  econ              String  @default("")
  excludedFromStats Boolean @default(false)
  inning            Inning  @relation(fields: [inningId], references: [id], onDelete: Cascade)
  player            Player? @relation(fields: [playerId], references: [id])
}
